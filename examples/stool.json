{
 "name": "Three-leg stool",
 "units": "mm",
 "description": "Round oak seat on three splayed turned-style legs and a stretcher ring. Uses mesh primitives (cylinders, tubes) with arbitrary rotations.",
 "assumptions": [
  "Round and splayed parts are mesh primitives: they export and render exactly, but are excluded from the joint-fill check."
 ],
 "params": {
  "R": {
   "value": 180,
   "min": 120,
   "max": 260,
   "step": 10,
   "label": "Seat radius"
  },
  "H": {
   "value": 450,
   "min": 300,
   "max": 700,
   "step": 10,
   "label": "Height"
  },
  "splay": {
   "value": 9,
   "min": 0,
   "max": 15,
   "step": 1,
   "label": "Leg splay (deg)"
  },
  "seatT": {
   "expr": "30"
  },
  "legR": {
   "expr": "15"
  },
  "rt": {
   "expr": "R*0.55"
  },
  "Hs": {
   "expr": "H-seatT"
  },
  "rb": {
   "expr": "rt+Hs*tan(splay)"
  },
  "Ll": {
   "expr": "Hs/cos(splay)"
  },
  "rz": {
   "expr": "Hs*0.38"
  },
  "rr": {
   "expr": "rb-rz*tan(splay)"
  }
 },
 "groups": [
  {
   "id": "legs",
   "name": "Legs & ring"
  },
  {
   "id": "seat",
   "name": "Seat"
  }
 ],
 "steps": [
  "Wedge the legs into the seat",
  "Slide the stretcher ring onto the legs",
  "Fit the seat"
 ],
 "parts": [
  {
   "id": "leg",
   "name": "Leg",
   "group": "legs",
   "material": "oak",
   "grain": "z",
   "spec": "\u00d830 round tenon, wedged through the seat",
   "prims": [
    {
     "type": "cylinder",
     "base": [
      0,
      0,
      0
     ],
     "axis": "+z",
     "length": "Ll",
     "r": "legR",
     "seg": 28
    }
   ],
   "instances": [
    {
     "pos": [
      "rb*cos(i*120+30)",
      "rb*sin(i*120+30)",
      0
     ],
     "rot": [
      0,
      "-splay",
      "i*120+30"
     ],
     "step": 0,
     "repeat": {
      "var": "i",
      "count": 3
     }
    }
   ]
  },
  {
   "id": "ring",
   "name": "Stretcher ring",
   "group": "legs",
   "material": "oak",
   "prims": [
    {
     "type": "tube",
     "base": [
      0,
      0,
      "rz"
     ],
     "axis": "+z",
     "length": 20,
     "ro": "rr+legR+6",
     "ri": "rr-legR-6",
     "seg": 64
    }
   ],
   "instances": [
