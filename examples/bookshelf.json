{
 "name": "Bookshelf with drawers",
 "units": "mm",
 "description": "Parametric oak bookshelf. Fixed shelves are housed in stopped dados, the back is a floating ply panel in rabbets, the bottom bay holds two drawers with rabbeted fronts and grooved bottoms. No hardware.",
 "assumptions": [
  "Proportions are generic; all sizes are parameters."
 ],
