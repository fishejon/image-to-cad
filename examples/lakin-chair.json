          "edgeR": 12,
          "bulge": { "top": 5, "bottom": 1 },
          "taper": { "k": 0.02 },
          "bend": 1
        }
      ],
      "instances": [
        { "pos": ["W/2", "legD+28+(seatD-legD*1.8)/2", "Hs+deckT+seatT/2"], "step": 3 }
