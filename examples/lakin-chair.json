{
  "name": "Lakin-style dining chair",
  "units": "mm",
  "description": "Approx of Crate & Barrel Lakin: continuous raked rear posts, tapered front legs, inset oatmeal cushion, horizontal back panel. Catalog W18 D20.63 H32 seatH19.5 seatD18.5.",
  "assumptions": [
    "Approx for silhouette / few-shot — front leg↔apron fillet is simplified (no organic carve).",
    "Mesh posts/legs: no exact joint-fill.",
    "Inset cushion sits inside the seat frame outline."
  ],
  "params": {
    "W": { "value": 457, "min": 420, "max": 500, "step": 5, "label": "Overall width" },
    "D": { "value": 524, "min": 480, "max": 580, "step": 5, "label": "Overall depth" },
    "Hs": { "value": 495, "min": 460, "max": 520, "step": 5, "label": "Seat height" },
    "Hb": { "value": 813, "min": 760, "max": 860, "step": 5, "label": "Overall height" },
    "seatD": { "value": 470, "min": 430, "max": 500, "step": 5, "label": "Seat depth" },
    "legW": { "expr": "42" },
    "legD": { "expr": "28" },
    "railT": { "expr": "22" },
    "railH": { "expr": "48" },
    "deckT": { "expr": "14" },
    "seatT": { "expr": "42" },
    "panelH": { "expr": "110" },
    "panelT": { "expr": "14" }
