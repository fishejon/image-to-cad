ANTHROPIC_API_KEY=sk-ant-...
# Optional. Default is https://api.anthropic.com
# ANTHROPIC_BASE_URL=
# RATE_PER_MIN=30
# Phase 1 telemetry uses in-memory + structured logs on /api/events and /api/feedback.
# Postgres (Neon) comes in a later phase when DATABASE_URL is set.
# PostHog (browser project API key — safe to expose via /api/status):
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com
# Langfuse (server-only; OTEL traces on /api/messages — never expose secret to browser):
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# US cloud: https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production
# Postgres / Neon (HITL durable store — optional; app works offline without it):
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# DATABASE_SSL=0
# Optional R2/S3 for consented run images only:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://pub-….r2.dev
# S3_ENDPOINT=   # alternative to R2_ACCOUNT_ID




