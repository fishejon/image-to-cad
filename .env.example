ANTHROPIC_API_KEY=sk-ant-...
# Optional. Default is https://api.anthropic.com
# ANTHROPIC_BASE_URL=
# RATE_PER_MIN=30
# Phase 1 telemetry uses in-memory + structured logs on /api/events and /api/feedback.
# Postgres (Neon) comes in a later phase when DATABASE_URL is set.
# PostHog (browser project API key — safe to expose via /api/status):
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com

